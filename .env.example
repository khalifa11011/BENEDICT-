# BENEDICT environment configuration
MONGODB_URI=mongodb://127.0.0.1:27017/benedict
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000

# Optional
CORS_ORIGIN=
OPENAI_API_KEY=

# Email delivery for password reset (any real SMTP provider:
# Resend, SendGrid, Mailgun, Postmark, Gmail App Password, ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=BENEDICT <no-reply@yourdomain.com>
